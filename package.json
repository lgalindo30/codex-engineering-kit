{
  "name": "codex-engineering-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engineeringKit": {
    "requireCommitScope": true
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "setup:global": "bun scripts/setup.ts install",
    "setup:doctor": "bun scripts/setup.ts doctor",
    "setup:restore": "bun scripts/setup.ts restore",
    "setup:plugin": "bun scripts/plugin.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "validate": "bun scripts/validate.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run validate",
    "security:check": "bun audit",
    "release:bump": "bun scripts/release.ts bump",
    "release:check-push": "bun scripts/release.ts check-push",
    "release:check-range": "bun scripts/release.ts check-range"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
